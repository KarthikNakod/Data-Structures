#include<stdio.h>

int size = 5;
int top = -1 ;
int stack[5];

void push(int n){
    if(top<size-1){ 
    top++;
    stack[top] = n;
    printf("%d is pushed into the stack\n", n);
    }
    else if(top==size-1){
        printf("Stack Overflow\n");
    }
}

void pop(){
    if(top==-1){
        printf("Stack Underflow\n");
    }
    else{ 
    top--;
    printf("Stack value poped out\n");
    }
}

void display(){
    if(top!=-1){
    for(int i=0; i<=top; i++){
        printf("%d\t", stack[i]);
    }
    printf("\n");
    }

    else if(top==-1){
        printf("Stack is Empty\n");
    }
}

int main(){
    
    printf("1.Push \n2.Pop \n3.Display \n4.Exit\n");
    int choice, n;
    while(1){
        printf("Enter your choice :");
        scanf("%d", &choice);

        switch(choice){
            case 1: 
            printf("Enter a number to push :");
            scanf("%d", &n);
            push(n);
            break;

            case 2:
            pop();
            break;

            case 3:
            display();
            break;

            case 4:
            printf("Exiting the program\n");
            return 0;

            default : printf("Invalid Choice\n");
        }
    }
}




